    test.assert_eq(dhcp6client.client_state(var c), dhcp6client.DHCP6_STATE_SOLICIT)

// ── Prefix delegation ───────────────────────────────────────────────

@test
fn test_a_client_that_wants_a_prefix_and_an_address_binds_both() [io]
    var c = new_client(dhcp6client.DHCP6_WANT_NA | dhcp6client.DHCP6_WANT_PD)
    var out: Vec[u8; 1024] = Vec.new()
    let _s = start(var c, var out)
    test.assert_eq(dhcp6opt.find_ia(var out, dhcp6msg.DHCP6_OPT_IA_NA, 1) >= 0, true)
    test.assert_eq(dhcp6opt.find_ia(var out, dhcp6msg.DHCP6_OPT_IA_PD, 2) >= 0, true)

    var adv = spec(dhcp6msg.DHCP6_ADVERTISE, 0x01F402)
    adv.parts = S_PD
    test.assert_eq(feed(var c, 600, rnd(1000, 9), adv, var out), dhcp6client.DHCP6_ACT_NONE)
    let _t = dhcp6client.client_tick(var c, 1550, rnd(1000, 3), var out)
    test.assert_eq(dhcp6msg.msg_type(var out), dhcp6msg.DHCP6_REQUEST)

    test.case("the Reply grants an address of 7200 seconds and a prefix of 3600: T1 is the earlier")
    var rep = spec(dhcp6msg.DHCP6_REPLY, 0x03E803)
    rep.parts = S_NA | S_PD
    rep.pl = 7200
    rep.vl = 10800
    rep.ppl = 3600
    rep.pvl = 5400
    test.assert_eq(feed(var c, 1600, rnd(1000, 9), rep, var out), dhcp6client.DHCP6_ACT_BOUND)
    test.assert_eq(dhcp6client.client_has_address(var c), true)
    test.assert_eq(dhcp6client.client_has_prefix(var c), true)
    test.assert_eq(dhcp6client.client_prefix_length(var c), 56)
    test.assert_eq(dhcp6msg.ip6_eq(dhcp6client.client_prefix(var c), delegated()), true)
    test.assert_eq(dhcp6client.client_t1_at(var c), 1600 + 1800000)

    test.case("a Renew carries both associations, each with what it holds")
    test.assert_eq(dhcp6client.client_tick(var c, 1600 + 1800000, rnd(1000, 4), var out),
        dhcp6client.DHCP6_ACT_SEND)
    test.assert_eq(addr_in(var out) >= 0, true)
    let pd = dhcp6opt.find_ia(var out, dhcp6msg.DHCP6_OPT_IA_PD, 2)
    let p = dhcp6msg.find_option(var out,
        dhcp6opt.ia_options_start(pd),
        dhcp6msg.opt_end(var out, pd),
        dhcp6msg.DHCP6_OPT_IAPREFIX,
        0)
    test.assert_eq(dhcp6opt.iaprefix_length(var out, p), 56)
    test.assert_eq(dhcp6opt.iaprefix_valid(var out, p), 0)

@test
fn test_t1_is_the_earliest_of_two_ias_and_the_lease_ends_with_the_longest() [io]
    var c = new_client(dhcp6client.DHCP6_WANT_NA | dhcp6client.DHCP6_WANT_PD)
    var out: Vec[u8; 1024] = Vec.new()
    let _s = start(var c, var out)
    var adv = spec(dhcp6msg.DHCP6_ADVERTISE, 0x01F402)
    adv.parts = S_NA | S_PD
    let _f = feed(var c, 600, rnd(1000, 9), adv, var out)
    let _t = dhcp6client.client_tick(var c, 1550, rnd(1000, 3), var out)
    var rep = spec(dhcp6msg.DHCP6_REPLY, 0x03E803)
    rep.parts = S_NA | S_PD
    rep.t1 = 100
    rep.t2 = 200
    rep.pl = 300
    rep.vl = 1000
    rep.pt1 = 50
    rep.pt2 = 400
    rep.ppl = 300
    rep.pvl = 2000
    let _r = feed(var c, 1600, rnd(1000, 9), rep, var out)
    test.assert_eq(dhcp6client.client_t1_at(var c), 1600 + 50000)
    test.assert_eq(dhcp6client.client_t2_at(var c), 1600 + 200000)
    test.assert_eq(dhcp6client.client_expires_at(var c), 1600 + 2000000)

@test
fn test_a_client_wants_only_what_it_asked_for() [io]
    var c = new_client(dhcp6client.DHCP6_WANT_PD)
    var out: Vec[u8; 1024] = Vec.new()
    let _s = start(var c, var out)
    test.assert_eq(dhcp6opt.find_ia(var out, dhcp6msg.DHCP6_OPT_IA_NA, 1), -1)
    test.assert_eq(dhcp6opt.find_ia(var out, dhcp6msg.DHCP6_OPT_IA_PD, 2) >= 0, true)
    var adv = spec(dhcp6msg.DHCP6_ADVERTISE, 0x01F402)
    adv.parts = S_NA
    test.assert_eq(feed(var c, 600, rnd(1000, 9), adv, var out), dhcp6client.DHCP6_ACT_NONE)

// ── Release and Decline ─────────────────────────────────────────────

@test
fn test_release_gives_the_lease_back_and_waits_for_the_reply() [io]
    var c = new_client(dhcp6client.DHCP6_WANT_NA | dhcp6client.DHCP6_WANT_PD)
    test.assert_eq(bind(var c, S_NA | S_PD, 0, 0, 7200, 10800), dhcp6client.DHCP6_ACT_BOUND)
    var out: Vec[u8; 1024] = Vec.new()

    test.assert_eq(dhcp6client.client_release(var c, 5000, rnd(1000, 6), var out), dhcp6client.DHCP6_ACT_SEND)
    test.assert_eq(dhcp6client.client_state(var c), dhcp6client.DHCP6_STATE_RELEASE)
    test.assert_eq(dhcp6msg.msg_type(var out), dhcp6msg.DHCP6_RELEASE)
    test.assert_eq(dhcp6msg.xid(var out), 0x03E806)
    test.assert_eq(dhcp6msg.find(var out, dhcp6msg.DHCP6_OPT_SERVERID) >= 0, true)
    test.assert_eq(addr_in(var out) >= 0, true)
    test.assert_eq(dhcp6opt.find_ia(var out, dhcp6msg.DHCP6_OPT_IA_PD, 2) >= 0, true)
    test.assert_eq(dhcp6opt.oro_count(var out), 0)
    test.assert_eq(dhcp6client.client_next_at(var c), 5000 + 1000)

    test.case("a Reply from the server ends it")
    var rep = spec(dhcp6msg.DHCP6_REPLY, 0x03E806)
    test.assert_eq(feed(var c, 5100, rnd(1000, 9), rep, var out), dhcp6client.DHCP6_ACT_RELEASED)
    test.assert_eq(dhcp6client.client_state(var c), dhcp6client.DHCP6_STATE_IDLE)
    test.assert_eq(dhcp6client.client_has_lease(var c), false)
    test.assert_eq(dhcp6client.client_next_at(var c), -1)
    test.assert_eq(dhcp6client.client_tick(var c, 999999, rnd(1000, 9), var out), dhcp6client.DHCP6_ACT_NONE)

    test.case("restart takes an idle client back to INIT")
    dhcp6client.client_restart(var c)
    test.assert_eq(dhcp6client.client_state(var c), dhcp6client.DHCP6_STATE_INIT)

@test
fn test_a_release_that_nobody_answers_ends_after_four_transmissions() [io]
    var c = new_client(dhcp6client.DHCP6_WANT_NA)
    test.assert_eq(bind(var c, S_NA, 0, 0, 7200, 10800), dhcp6client.DHCP6_ACT_BOUND)
    var out: Vec[u8; 1024] = Vec.new()
    test.assert_eq(dhcp6client.client_release(var c, 5000, rnd(1000, 6), var out), dhcp6client.DHCP6_ACT_SEND)
    test.assert_eq(dhcp6client.client_next_at(var c), 6000)
    test.assert_eq(dhcp6client.client_tick(var c, 6000, rnd(1000, 6), var out), dhcp6client.DHCP6_ACT_SEND)
    test.assert_eq(dhcp6client.client_next_at(var c), 8000)
    test.assert_eq(dhcp6client.client_tick(var c, 8000, rnd(1000, 6), var out), dhcp6client.DHCP6_ACT_SEND)
    test.assert_eq(dhcp6client.client_next_at(var c), 12000)
    test.assert_eq(dhcp6client.client_tick(var c, 12000, rnd(1000, 6), var out), dhcp6client.DHCP6_ACT_SEND)
    test.assert_eq(dhcp6client.client_next_at(var c), 20000)
    test.assert_eq(dhcp6client.client_tick(var c, 20000, rnd(1000, 6), var out), dhcp6client.DHCP6_ACT_RELEASED)
    test.assert_eq(dhcp6client.client_state(var c), dhcp6client.DHCP6_STATE_IDLE)

@test
fn test_release_and_decline_need_a_lease_and_a_server() [io]
    var c = new_client(dhcp6client.DHCP6_WANT_NA)
    var out: Vec[u8; 1024] = Vec.new()
    test.assert_eq(dhcp6client.client_release(var c, 0, rnd(1000, 6), var out), dhcp6client.DHCP6_ACT_NONE)
    test.assert_eq(dhcp6client.client_decline(var c, 0, rnd(1000, 6), var out), dhcp6client.DHCP6_ACT_NONE)
    test.assert_eq(dhcp6client.client_confirm(var c, 0, rnd(1000, 6)), false)
    test.assert_eq(out.len(), 0)

    test.case("a client that wants only a prefix cannot decline")
    var p = new_client(dhcp6client.DHCP6_WANT_PD)
    test.assert_eq(bind(var p, S_PD, 0, 0, 7200, 10800), dhcp6client.DHCP6_ACT_BOUND)
    test.assert_eq(dhcp6client.client_decline(var p, 5000, rnd(1000, 6), var out), dhcp6client.DHCP6_ACT_NONE)
    test.assert_eq(dhcp6client.client_confirm(var p, 5000, rnd(1000, 6)), false)

@test
fn test_decline_reports_the_address_and_not_the_prefix() [io]
    var c = new_client(dhcp6client.DHCP6_WANT_NA | dhcp6client.DHCP6_WANT_PD)
    test.assert_eq(bind(var c, S_NA | S_PD, 0, 0, 7200, 10800), dhcp6client.DHCP6_ACT_BOUND)
    var out: Vec[u8; 1024] = Vec.new()
    test.assert_eq(dhcp6client.client_decline(var c, 5000, rnd(1000, 7), var out), dhcp6client.DHCP6_ACT_SEND)
    test.assert_eq(dhcp6client.client_state(var c), dhcp6client.DHCP6_STATE_DECLINE)
    test.assert_eq(dhcp6msg.msg_type(var out), dhcp6msg.DHCP6_DECLINE)
    test.assert_eq(addr_in(var out) >= 0, true)
    test.assert_eq(dhcp6opt.find_ia(var out, dhcp6msg.DHCP6_OPT_IA_PD, 2), -1)
    test.assert_eq(dhcp6client.client_has_lease(var c), true)

    test.case("the Reply ends it, and a Reply from another server does not")
    var other = spec(dhcp6msg.DHCP6_REPLY, 0x03E807)
    other.who = 2
    test.assert_eq(feed(var c, 5100, rnd(1000, 9), other, var out), dhcp6client.DHCP6_ACT_NONE)
    var rep = spec(dhcp6msg.DHCP6_REPLY, 0x03E807)
    test.assert_eq(feed(var c, 5200, rnd(1000, 9), rep, var out), dhcp6client.DHCP6_ACT_RELEASED)
    test.assert_eq(dhcp6client.client_state(var c), dhcp6client.DHCP6_STATE_IDLE)

@test
fn test_a_decline_nobody_answers_ends_after_four_transmissions() [io]
    var c = new_client(dhcp6client.DHCP6_WANT_NA)
    test.assert_eq(bind(var c, S_NA, 0, 0, 7200, 10800), dhcp6client.DHCP6_ACT_BOUND)
    var out: Vec[u8; 1024] = Vec.new()
    let _d = dhcp6client.client_decline(var c, 5000, rnd(1000, 7), var out)
    var now = 5000
    var wait = 1000
    for _ in 0..3
        now = now + wait
        test.assert_eq(dhcp6client.client_tick(var c, now, rnd(1000, 7), var out), dhcp6client.DHCP6_ACT_SEND)
        wait = wait * 2
    now = now + wait
    test.assert_eq(dhcp6client.client_tick(var c, now, rnd(1000, 7), var out), dhcp6client.DHCP6_ACT_RELEASED)

@test
fn test_a_release_goes_unicast_when_the_server_gave_its_address() [io]
    var c = new_client(dhcp6client.DHCP6_WANT_NA)
    test.assert_eq(bind(var c, S_NA | S_UNICAST, 0, 0, 7200, 10800), dhcp6client.DHCP6_ACT_BOUND)
    var out: Vec[u8; 1024] = Vec.new()
    test.assert_eq(dhcp6client.client_release(var c, 5000, rnd(1000, 6), var out),
        dhcp6client.DHCP6_ACT_SEND_UNICAST)

// ── Confirm ─────────────────────────────────────────────────────────

@test
fn test_confirm_asks_whether_the_address_is_still_on_the_link() [io]
    var c = new_client(dhcp6client.DHCP6_WANT_NA)
    test.assert_eq(bind(var c, S_NA, 0, 0, 7200, 10800), dhcp6client.DHCP6_ACT_BOUND)
    var out: Vec[u8; 1024] = Vec.new()
    test.assert_eq(dhcp6client.client_confirm(var c, 5000, rnd(500, 1)), true)
    test.assert_eq(dhcp6client.client_state(var c), dhcp6client.DHCP6_STATE_STARTING)
    test.assert_eq(dhcp6client.client_next_at(var c), 5500)
    test.assert_eq(dhcp6client.client_tick(var c, 5499, rnd(1000, 6), var out), dhcp6client.DHCP6_ACT_NONE)

    test.assert_eq(dhcp6client.client_tick(var c, 5500, rnd(1000, 6), var out), dhcp6client.DHCP6_ACT_SEND)
    test.assert_eq(dhcp6client.client_state(var c), dhcp6client.DHCP6_STATE_CONFIRM)
    test.assert_eq(dhcp6msg.msg_type(var out), dhcp6msg.DHCP6_CONFIRM)
    test.assert_eq(dhcp6msg.xid(var out), 0x03E806)
    test.assert_eq(dhcp6msg.find(var out, dhcp6msg.DHCP6_OPT_SERVERID), -1)
    test.assert_eq(addr_in(var out) >= 0, true)
    test.assert_eq(dhcp6opt.oro_count(var out), 0)
    test.assert_eq(dhcp6client.client_has_lease(var c), true)
    test.assert_eq(dhcp6client.client_next_at(var c), 5500 + 1000)

    test.case("a Reply with Success confirms, and the lease keeps its times")
    var rep = spec(dhcp6msg.DHCP6_REPLY, 0x03E806)
    rep.who = 2
    test.assert_eq(feed(var c, 5600, rnd(1000, 9), rep, var out), dhcp6client.DHCP6_ACT_CONFIRMED)
    test.assert_eq(dhcp6client.client_state(var c), dhcp6client.DHCP6_STATE_BOUND)
    test.assert_eq(dhcp6client.client_t1_at(var c), 1600 + 3600000)

@test
fn test_confirm_is_refused_for_a_client_that_also_holds_a_prefix() [io]
    var c = new_client(dhcp6client.DHCP6_WANT_NA | dhcp6client.DHCP6_WANT_PD)
    test.assert_eq(bind(var c, S_NA | S_PD, 0, 0, 7200, 10800), dhcp6client.DHCP6_ACT_BOUND)
    test.assert_eq(dhcp6client.client_confirm(var c, 5000, rnd(500, 1)), false)
    test.assert_eq(dhcp6client.client_state(var c), dhcp6client.DHCP6_STATE_BOUND)

@test
fn test_confirm_answered_not_on_link_loses_the_address() [io]
    var c = new_client(dhcp6client.DHCP6_WANT_NA)
    test.assert_eq(bind(var c, S_NA, 0, 0, 7200, 10800), dhcp6client.DHCP6_ACT_BOUND)
    var out: Vec[u8; 1024] = Vec.new()
    let _a = dhcp6client.client_confirm(var c, 5000, rnd(500, 1))
    let _b = dhcp6client.client_tick(var c, 5500, rnd(1000, 6), var out)
    var rep = spec(dhcp6msg.DHCP6_REPLY, 0x03E806)
    rep.status = dhcp6msg.DHCP6_STATUS_NOT_ON_LINK
    test.assert_eq(feed(var c, 5600, rnd(1000, 9), rep, var out), dhcp6client.DHCP6_ACT_REJECTED)
    test.assert_eq(dhcp6client.client_state(var c), dhcp6client.DHCP6_STATE_INIT)
    test.assert_eq(dhcp6client.client_has_address(var c), false)

@test
fn test_confirm_with_another_status_is_ignored_and_no_answer_keeps_the_lease() [io]
    var c = new_client(dhcp6client.DHCP6_WANT_NA)
    test.assert_eq(bind(var c, S_NA, 0, 0, 7200, 10800), dhcp6client.DHCP6_ACT_BOUND)
    var out: Vec[u8; 1024] = Vec.new()
    let _a = dhcp6client.client_confirm(var c, 5000, rnd(500, 1))
    let _b = dhcp6client.client_tick(var c, 5500, rnd(1000, 6), var out)
    var rep = spec(dhcp6msg.DHCP6_REPLY, 0x03E806)
    rep.status = dhcp6msg.DHCP6_STATUS_UNSPEC_FAIL
    test.assert_eq(feed(var c, 5600, rnd(1000, 9), rep, var out), dhcp6client.DHCP6_ACT_NONE)
    test.assert_eq(dhcp6client.client_state(var c), dhcp6client.DHCP6_STATE_CONFIRM)

    test.case("the timeouts are 1000, 2000 and 4000 and then 4000 again, up to ten seconds in all")
    test.assert_eq(dhcp6client.client_tick(var c, 6500, rnd(1000, 6), var out), dhcp6client.DHCP6_ACT_SEND)
    test.assert_eq(dhcp6client.client_next_at(var c), 6500 + 2000)
    test.assert_eq(dhcp6client.client_tick(var c, 8500, rnd(1000, 6), var out), dhcp6client.DHCP6_ACT_SEND)
    test.assert_eq(dhcp6client.client_next_at(var c), 8500 + 4000)
    test.assert_eq(dhcp6client.client_tick(var c, 12500, rnd(1000, 6), var out), dhcp6client.DHCP6_ACT_SEND)
    test.case("after ten seconds from the first Confirm the client goes back to using its lease")
    test.assert_eq(dhcp6client.client_tick(var c, 15500, rnd(1000, 6), var out), dhcp6client.DHCP6_ACT_NONE)
    test.assert_eq(dhcp6client.client_state(var c), dhcp6client.DHCP6_STATE_BOUND)
    test.assert_eq(dhcp6client.client_has_address(var c), true)
    test.assert_eq(dhcp6client.client_next_at(var c), 1600 + 3600000)

// ── Information-request ─────────────────────────────────────────────

@test
fn test_a_stateless_client_asks_for_parameters_and_refreshes_them() [io]
    var c = new_client(dhcp6client.DHCP6_STATELESS)
    var out: Vec[u8; 1024] = Vec.new()
    test.assert_eq(dhcp6client.client_tick(var c, 0, rnd(500, 1), var out), dhcp6client.DHCP6_ACT_NONE)
    test.assert_eq(dhcp6client.client_tick(var c, 500, rnd(500, 2), var out), dhcp6client.DHCP6_ACT_SEND)
    test.assert_eq(dhcp6client.client_state(var c), dhcp6client.DHCP6_STATE_INFORM)
    test.assert_eq(dhcp6msg.msg_type(var out), dhcp6msg.DHCP6_INFORMATION_REQUEST)
    test.assert_eq(dhcp6msg.xid(var out), 0x01F402)
    test.assert_eq(dhcp6msg.find(var out, dhcp6msg.DHCP6_OPT_CLIENTID) >= 0, true)
    test.assert_eq(dhcp6msg.find(var out, dhcp6msg.DHCP6_OPT_SERVERID), -1)
    test.assert_eq(dhcp6opt.find_ia(var out, dhcp6msg.DHCP6_OPT_IA_NA, 1), -1)
    test.assert_eq(dhcp6opt.find_ia(var out, dhcp6msg.DHCP6_OPT_IA_PD, 2), -1)
    test.assert_eq(dhcp6opt.oro_contains(var out, 83), true)
    test.assert_eq(dhcp6opt.oro_contains(var out, 32), true)
    test.assert_eq(dhcp6opt.oro_contains(var out, 23), true)
    test.assert_eq(dhcp6opt.oro_contains(var out, 82), false)
    test.assert_eq(dhcp6opt.elapsed_time(var out), 0)
    test.assert_eq(dhcp6client.client_next_at(var c), 500 + 950)

    test.case("the Reply sets the parameters and the refresh time")
    var rep = spec(dhcp6msg.DHCP6_REPLY, 0x01F402)
    rep.parts = S_DNS | S_DOMAIN | S_NTP | S_REFRESH | S_MAX_RT
    test.assert_eq(feed(var c, 700, rnd(1000, 9), rep, var out), dhcp6client.DHCP6_ACT_INFORMED)
    test.assert_eq(dhcp6client.client_state(var c), dhcp6client.DHCP6_STATE_INFORMED)
    test.assert_eq(dhcp6client.client_dns_count(var c), 2)
    test.assert_eq(dhcp6client.client_domain_count(var c), 2)
    test.assert_eq(dhcp6client.client_ntp(var c).d, 0x123)
    test.assert_eq(dhcp6client.client_has_lease(var c), false)
    test.assert_eq(dhcp6client.client_next_at(var c), 700 + 3600000)

    test.case("when the refresh time ends a new Information-request goes")
    test.assert_eq(dhcp6client.client_tick(var c, 700 + 3599999, rnd(1000, 3), var out),
        dhcp6client.DHCP6_ACT_NONE)
    test.assert_eq(dhcp6client.client_tick(var c, 700 + 3600000, rnd(1000, 3), var out),
        dhcp6client.DHCP6_ACT_SEND)
    test.assert_eq(dhcp6msg.msg_type(var out), dhcp6msg.DHCP6_INFORMATION_REQUEST)
    test.assert_eq(dhcp6msg.xid(var out), 0x03E803)

@test
fn test_information_request_replies_the_client_must_ignore() [io]
    var c = new_client(dhcp6client.DHCP6_STATELESS)
    var out: Vec[u8; 1024] = Vec.new()
    let _a = dhcp6client.client_tick(var c, 0, rnd(500, 1), var out)
    let _b = dhcp6client.client_tick(var c, 500, rnd(500, 2), var out)
    var bad = spec(dhcp6msg.DHCP6_REPLY, 0x01F402)
    bad.status = dhcp6msg.DHCP6_STATUS_UNSPEC_FAIL
    test.assert_eq(feed(var c, 700, rnd(1000, 9), bad, var out), dhcp6client.DHCP6_ACT_NONE)
    var adv = spec(dhcp6msg.DHCP6_ADVERTISE, 0x01F402)
    test.assert_eq(feed(var c, 700, rnd(1000, 9), adv, var out), dhcp6client.DHCP6_ACT_NONE)
    test.assert_eq(dhcp6client.client_state(var c), dhcp6client.DHCP6_STATE_INFORM)

    test.case("a refresh time under ten minutes is held at ten minutes")
    var m: Vec[u8; 1024] = Vec.new()
    var s = spec(dhcp6msg.DHCP6_REPLY, 0x01F402)
    let _ok = srv(s, var m)
    let _t = dhcp6msg.put_info_refresh_time(var m, 5)
    test.assert_eq(dhcp6client.client_receive(var c, 800, rnd(1000, 9), var m, var out),
        dhcp6client.DHCP6_ACT_INFORMED)
    test.assert_eq(dhcp6client.client_next_at(var c), 800 + 600000)

@test
fn test_information_request_timeouts_use_inf_max_rt() [io]
    var c = new_client(dhcp6client.DHCP6_STATELESS)
    var out: Vec[u8; 1024] = Vec.new()
    let _a = dhcp6client.client_tick(var c, 0, rnd(1000, 1), var out)
    let _b = dhcp6client.client_tick(var c, 1000, rnd(1000, 2), var out)
    test.assert_eq(dhcp6client.client_next_at(var c), 1000 + 1000)
    test.assert_eq(dhcp6client.client_tick(var c, 2000, rnd(1000, 2), var out), dhcp6client.DHCP6_ACT_SEND)
    test.assert_eq(dhcp6client.client_next_at(var c), 2000 + 2000)

// ── SOL_MAX_RT ──────────────────────────────────────────────────────

@test
fn test_sol_max_rt_from_a_server_caps_the_solicit_timeout() [io]
    var c = new_client(dhcp6client.DHCP6_WANT_NA)
    var out: Vec[u8; 1024] = Vec.new()
    let _s = start(var c, var out)
    test.case("an Advertise that is ignored for what it holds still sets SOL_MAX_RT")
    var adv = spec(dhcp6msg.DHCP6_ADVERTISE, 0x01F402)
    adv.parts = S_MAX_RT
    test.assert_eq(feed(var c, 600, rnd(1000, 9), adv, var out), dhcp6client.DHCP6_ACT_NONE)
    var now = 1550
    var rt = 1050
    for _ in 0..8
        test.assert_eq(dhcp6client.client_tick(var c, now, rnd(1000, 3), var out), dhcp6client.DHCP6_ACT_SEND)
        rt = rt * 2
        if rt > 60000
            rt = 60000
        test.assert_eq(dhcp6client.client_next_at(var c), now + rt)
        now = now + rt
    test.assert_eq(rt, 60000)

// ── What the stages share ───────────────────────────────────────────

@test
fn test_a_tick_before_the_time_does_nothing_in_every_state() [io]
    var c = new_client(dhcp6client.DHCP6_WANT_NA)
    var out: Vec[u8; 1024] = Vec.new()
    let _s = start(var c, var out)
    test.assert_eq(dhcp6client.client_tick(var c, 1000, rnd(1000, 3), var out), dhcp6client.DHCP6_ACT_NONE)
    var d = new_client(dhcp6client.DHCP6_WANT_NA)
    let _b = bind(var d, S_NA, 0, 0, 7200, 10800)
    test.assert_eq(dhcp6client.client_tick(var d, 2000, rnd(1000, 3), var out), dhcp6client.DHCP6_ACT_NONE)
    let _r = dhcp6client.client_tick(var d, 1600 + 3600000, rnd(1000, 4), var out)
    test.assert_eq(dhcp6client.client_tick(var d, 1600 + 3600001, rnd(1000, 4), var out),
        dhcp6client.DHCP6_ACT_NONE)

@test
fn test_a_reconfigure_message_is_ignored_in_every_state() [io]
    var c = new_client(dhcp6client.DHCP6_WANT_NA)
    test.assert_eq(bind(var c, S_NA, 0, 0, 7200, 10800), dhcp6client.DHCP6_ACT_BOUND)
    var out: Vec[u8; 1024] = Vec.new()
    var m: Vec[u8; 1024] = Vec.new()
    let s = spec(dhcp6msg.DHCP6_RECONFIGURE, 0x03E803)
    let _ok = srv(s, var m)
    let _k = dhcp6msg.put_reconfigure_message(var m, dhcp6msg.DHCP6_RENEW)
    test.assert_eq(dhcp6client.client_receive(var c, 2000, 0, var m, var out), dhcp6client.DHCP6_ACT_NONE)
    test.assert_eq(dhcp6client.client_state(var c), dhcp6client.DHCP6_STATE_BOUND)
    test.case("a Reply in BOUND, with no exchange out, is ignored")
    var rep = spec(dhcp6msg.DHCP6_REPLY, 0x03E803)
    rep.parts = S_NA
    test.assert_eq(feed(var c, 2000, rnd(1000, 9), rep, var out), dhcp6client.DHCP6_ACT_NONE)
    test.case("and so is one in INIT")
    var d = new_client(dhcp6client.DHCP6_WANT_NA)
    test.assert_eq(feed(var d, 2000, rnd(1000, 9), rep, var out), dhcp6client.DHCP6_ACT_NONE)

@test
fn test_client_restart_forgets_everything_it_held() [io]
    var c = new_client(dhcp6client.DHCP6_WANT_NA | dhcp6client.DHCP6_WANT_PD)
    test.assert_eq(bind(var c, S_NA | S_PD | S_UNICAST, 0, 0, 7200, 10800), dhcp6client.DHCP6_ACT_BOUND)
    dhcp6client.client_restart(var c)
    test.assert_eq(dhcp6client.client_state(var c), dhcp6client.DHCP6_STATE_INIT)
    test.assert_eq(dhcp6client.client_has_lease(var c), false)
    test.assert_eq(dhcp6client.client_has_address(var c), false)
    test.assert_eq(dhcp6client.client_has_prefix(var c), false)
    var sd: Vec[u8; 130] = Vec.new()
    test.assert_eq(dhcp6client.client_server_id(var c, var sd), false)
    test.assert_eq(sd.len(), 0)
    test.assert_eq(dhcp6client.client_next_at(var c), 0)
    test.assert_eq(dhcp6client.client_remaining(var c, 100), 0)

@test
fn test_the_numbers_of_section_7_6_are_the_defaults() [io]
    test.assert_eq(dhcp6client.DHCP6_SOL_MAX_DELAY, 1000)
    test.assert_eq(dhcp6client.DHCP6_SOL_TIMEOUT, 1000)
    test.assert_eq(dhcp6client.DHCP6_SOL_MAX_RT, 3600000)
    test.assert_eq(dhcp6client.DHCP6_REQ_TIMEOUT, 1000)
    test.assert_eq(dhcp6client.DHCP6_REQ_MAX_RT, 30000)
    test.assert_eq(dhcp6client.DHCP6_REQ_MAX_RC, 10)
    test.assert_eq(dhcp6client.DHCP6_CNF_MAX_DELAY, 1000)
    test.assert_eq(dhcp6client.DHCP6_CNF_TIMEOUT, 1000)
    test.assert_eq(dhcp6client.DHCP6_CNF_MAX_RT, 4000)
    test.assert_eq(dhcp6client.DHCP6_CNF_MAX_RD, 10000)
    test.assert_eq(dhcp6client.DHCP6_REN_TIMEOUT, 10000)
    test.assert_eq(dhcp6client.DHCP6_REN_MAX_RT, 600000)
    test.assert_eq(dhcp6client.DHCP6_REB_TIMEOUT, 10000)
    test.assert_eq(dhcp6client.DHCP6_REB_MAX_RT, 600000)
    test.assert_eq(dhcp6client.DHCP6_INF_MAX_DELAY, 1000)
    test.assert_eq(dhcp6client.DHCP6_INF_TIMEOUT, 1000)
    test.assert_eq(dhcp6client.DHCP6_INF_MAX_RT, 3600000)
    test.assert_eq(dhcp6client.DHCP6_REL_TIMEOUT, 1000)
    test.assert_eq(dhcp6client.DHCP6_REL_MAX_RC, 4)
    test.assert_eq(dhcp6client.DHCP6_DEC_TIMEOUT, 1000)
    test.assert_eq(dhcp6client.DHCP6_DEC_MAX_RC, 4)

// ── Cases the lists and refusals leave ──────────────────────────────

// A Reply for the Request of `bind`, with a Domain Search List option
// holding the raw bytes in `raw` after the usual parts.
fn bind_with_domain_bytes(var c: dhcp6client.Dhcp6Client, raw: [Int]) -> Int
    var out: Vec[u8; 1024] = Vec.new()
    let _s = start(var c, var out)
    var adv = spec(dhcp6msg.DHCP6_ADVERTISE, 0x01F402)
    adv.parts = S_NA
    let _f = feed(var c, 600, rnd(1000, 9), adv, var out)
    let _t = dhcp6client.client_tick(var c, 1550, rnd(1000, 3), var out)
    var m: Vec[u8; 1024] = Vec.new()
    var rep = spec(dhcp6msg.DHCP6_REPLY, 0x03E803)
    rep.parts = S_NA
    let _ok = srv(rep, var m)
    let dl = dhcp6msg.open_option(var m, dhcp6msg.DHCP6_OPT_DOMAIN_LIST)
    for b in raw
        let _p = dhcp6msg.put_u8(var m, b)
    let _c = dhcp6msg.close_option(var m, dl)
    dhcp6client.client_receive(var c, 1600, rnd(1000, 9), var m, var out)

@test
fn test_the_domain_list_of_a_lease_is_read_name_by_name() [io]
    test.case("the root alone is one dot")
    var c = new_client(dhcp6client.DHCP6_WANT_NA)
    test.assert_eq(bind_with_domain_bytes(var c, [0]), dhcp6client.DHCP6_ACT_BOUND)
    test.assert_eq(dhcp6client.client_domain_count(var c), 1)
    var text: Vec[u8; 256] = Vec.new()
    test.assert_eq(dhcp6client.client_domain_text(var c, 0, var text), true)
    test.assert_eq(text.len(), 1)
    test.assert_eq(text[0] as Int, 0x2e)

    test.case("a name with no terminating zero is not a name")
    var d = new_client(dhcp6client.DHCP6_WANT_NA)
    test.assert_eq(bind_with_domain_bytes(var d, [3, 0x61, 0x62, 0x63]), dhcp6client.DHCP6_ACT_BOUND)
    test.assert_eq(dhcp6client.client_domain_count(var d), 0)
    test.assert_eq(dhcp6client.client_domain_text(var d, 0, var text), false)

    test.case("a compression pointer is not allowed in this option")
    var e = new_client(dhcp6client.DHCP6_WANT_NA)
    test.assert_eq(bind_with_domain_bytes(var e, [0xc0, 0x0c, 0]), dhcp6client.DHCP6_ACT_BOUND)
    test.assert_eq(dhcp6client.client_domain_count(var e), 0)

    test.case("a good name followed by a bad one counts the good one")
    var f = new_client(dhcp6client.DHCP6_WANT_NA)
    test.assert_eq(bind_with_domain_bytes(var f, [1, 0x61, 0, 1, 0x62, 9]), dhcp6client.DHCP6_ACT_BOUND)
    test.assert_eq(dhcp6client.client_domain_count(var f), 1)
    test.assert_eq(dhcp6client.client_domain_text(var f, 0, var text), true)
    test.assert_eq(text.len(), 1)

    test.case("a list longer than the 128 bytes the client keeps is dropped whole")
    var g = new_client(dhcp6client.DHCP6_WANT_NA)
    var big: [Int] = []
    for _ in 0..70
        big = list.append(big, [1, 0x61])
    big = list.append(big, [0])
    test.assert_eq(bind_with_domain_bytes(var g, big), dhcp6client.DHCP6_ACT_BOUND)
    test.assert_eq(dhcp6client.client_domain_count(var g), 0)

@test
fn test_a_refusal_of_the_prefix_is_a_refusal() [io]
    var c = new_client(dhcp6client.DHCP6_WANT_PD)
    test.assert_eq(bind(var c, S_PD, 0, 0, 7200, 10800), dhcp6client.DHCP6_ACT_BOUND)
    var out: Vec[u8; 1024] = Vec.new()
    let t1 = 1600 + 3600000
    let _r = dhcp6client.client_tick(var c, t1, rnd(1000, 4), var out)
    var rep = spec(dhcp6msg.DHCP6_REPLY, 0x03E804)
    rep.parts = S_PD
    rep.ia_status = dhcp6msg.DHCP6_STATUS_NO_BINDING
    test.assert_eq(feed(var c, t1 + 50, rnd(1000, 9), rep, var out), dhcp6client.DHCP6_ACT_REJECTED)
    test.assert_eq(dhcp6client.client_has_prefix(var c), false)

@test
fn test_a_failure_status_in_a_reply_to_a_renew_is_waited_out() [io]
    var c = new_client(dhcp6client.DHCP6_WANT_NA)
    test.assert_eq(bind(var c, S_NA, 0, 0, 7200, 10800), dhcp6client.DHCP6_ACT_BOUND)
    var out: Vec[u8; 1024] = Vec.new()
    let t1 = 1600 + 3600000
    let _r = dhcp6client.client_tick(var c, t1, rnd(1000, 4), var out)
    var rep = spec(dhcp6msg.DHCP6_REPLY, 0x03E804)
    rep.status = dhcp6msg.DHCP6_STATUS_UNSPEC_FAIL
    test.assert_eq(feed(var c, t1 + 50, rnd(1000, 9), rep, var out), dhcp6client.DHCP6_ACT_NONE)
    test.assert_eq(dhcp6client.client_state(var c), dhcp6client.DHCP6_STATE_RENEW)
    test.assert_eq(dhcp6client.client_has_address(var c), true)
