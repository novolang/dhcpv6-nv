    test.assert_eq(dhcp6msg.DHCP6_OPT_ORO, 6)
    test.assert_eq(dhcp6msg.DHCP6_OPT_PREFERENCE, 7)
    test.assert_eq(dhcp6msg.DHCP6_OPT_ELAPSED_TIME, 8)
    test.assert_eq(dhcp6msg.DHCP6_OPT_RELAY_MSG, 9)
    test.assert_eq(dhcp6msg.DHCP6_OPT_AUTH, 11)
    test.assert_eq(dhcp6msg.DHCP6_OPT_UNICAST, 12)
    test.assert_eq(dhcp6msg.DHCP6_OPT_STATUS_CODE, 13)
    test.assert_eq(dhcp6msg.DHCP6_OPT_RAPID_COMMIT, 14)
    test.assert_eq(dhcp6msg.DHCP6_OPT_USER_CLASS, 15)
    test.assert_eq(dhcp6msg.DHCP6_OPT_VENDOR_CLASS, 16)
    test.assert_eq(dhcp6msg.DHCP6_OPT_VENDOR_OPTS, 17)
    test.assert_eq(dhcp6msg.DHCP6_OPT_INTERFACE_ID, 18)
    test.assert_eq(dhcp6msg.DHCP6_OPT_RECONF_MSG, 19)
    test.assert_eq(dhcp6msg.DHCP6_OPT_RECONF_ACCEPT, 20)
    test.assert_eq(dhcp6msg.DHCP6_OPT_DNS_SERVERS, 23)
    test.assert_eq(dhcp6msg.DHCP6_OPT_DOMAIN_LIST, 24)
    test.assert_eq(dhcp6msg.DHCP6_OPT_IA_PD, 25)
    test.assert_eq(dhcp6msg.DHCP6_OPT_IAPREFIX, 26)
    test.assert_eq(dhcp6msg.DHCP6_OPT_INFO_REFRESH_TIME, 32)
    test.assert_eq(dhcp6msg.DHCP6_OPT_NTP_SERVER, 56)
    test.assert_eq(dhcp6msg.DHCP6_OPT_SOL_MAX_RT, 82)
    test.assert_eq(dhcp6msg.DHCP6_OPT_INF_MAX_RT, 83)
