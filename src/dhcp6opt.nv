// dhcp6opt.nv — the options of RFC 8415 read and written as values: the
// identity associations with their addresses and prefixes, the status
// code, the lists of RFC 3646 with the domain names of RFC 1035, the NTP
// server option of RFC 5908, the classes and the vendor options, the
// timer options, and the Authentication option, which is read and never
// verified.
//
// Every function is `@tier(embedded)` and `@no_alloc`.  An option is
// named by its offset in the message, as `dhcp6msg.find_option` answers
// it, and a reader here takes that offset.  A reader handed an offset
// that is not an option, or a message cut short, answers 0 or -1 and
// never faults.

use dhcp6msg

// ── Numbers the options fix ─────────────────────────────────────────

// The sub-option of the NTP Server option that holds a server's address
// (RFC 5908 section 4).
pub const DHCP6_NTP_SRV_ADDR = 1
// The sub-option that holds a multicast address.
pub const DHCP6_NTP_MC_ADDR = 2
// The sub-option that holds a server's name.
pub const DHCP6_NTP_SRV_FQDN = 3

// The smallest value a client accepts for SOL_MAX_RT and INF_MAX_RT, in
// seconds (sections 21.24 and 21.25).
pub const DHCP6_MAX_RT_MIN = 60
// The largest value a client accepts for SOL_MAX_RT and INF_MAX_RT, in
// seconds.
pub const DHCP6_MAX_RT_MAX = 86400

// The Information Refresh Time a client uses when the server sends
// none, and the least it accepts, in seconds (sections 7.6 and 21.23).
pub const DHCP6_IRT_DEFAULT = 86400
// The shortest Information Refresh Time a client accepts, in seconds.
pub const DHCP6_IRT_MINIMUM = 600

// Authentication protocol 2: delayed authentication (RFC 3315 section
// 21.4.2), which RFC 8415 keeps for reading only.
pub const DHCP6_AUTH_DELAYED = 2
// Authentication protocol 3: the reconfigure key (RFC 8415 section 20.4.1).
pub const DHCP6_AUTH_RECONFIGURE_KEY = 3

// ── Identity associations ───────────────────────────────────────────

// The offset of the IA_NA, IA_TA or IA_PD option with `code` and the
// identifier `iaid` among a message's own options, or -1.
pub @tier(embedded)
@no_alloc
fn find_ia(var m: Vec[u8; 1024], code: Int, iaid: Int) -> Int
    var found = -1
    for i in 0..64
        if found < 0
            let o = dhcp6msg.find_option(var m, dhcp6msg.options_start(var m), dhcp6msg.options_end(var m), code, i)
            if o >= 0 and dhcp6msg.u32_at(var m, o + 4) == iaid
                found = o
    found

// The identifier of an IA_NA, IA_TA or IA_PD option at `o`.
pub @tier(embedded)
@no_alloc
fn ia_iaid(var m: Vec[u8; 1024], o: Int) -> Int
    dhcp6msg.u32_at(var m, o + 4)

// T1 of an IA_NA or IA_PD, in seconds.
pub @tier(embedded)
@no_alloc
fn ia_t1(var m: Vec[u8; 1024], o: Int) -> Int
    dhcp6msg.u32_at(var m, o + 8)

// T2 of an IA_NA or IA_PD, in seconds.
pub @tier(embedded)
@no_alloc
fn ia_t2(var m: Vec[u8; 1024], o: Int) -> Int
    dhcp6msg.u32_at(var m, o + 12)

// Where the options inside an IA_NA or IA_PD start.
pub @tier(embedded)
@no_alloc
fn ia_options_start(o: Int) -> Int
    o + 16

// Where the options inside an IA_TA start: IA_TA has no T1 and T2.
pub @tier(embedded)
@no_alloc
fn ia_ta_options_start(o: Int) -> Int
    o + 8

// Whether an IA_NA or IA_PD option is long enough for its fields and
// does not have T1 greater than T2 with both above zero, which
// section 21.4 says the client discards.
pub @tier(embedded)
@no_alloc
fn ia_is_usable(var m: Vec[u8; 1024], o: Int) -> Bool
    let t1 = ia_t1(var m, o)
    let t2 = ia_t2(var m, o)
    o >= 0 and dhcp6msg.opt_len(var m, o) >= 12 and dhcp6msg.opt_end(var m, o) <= m.len() and not (t1 > 0 and t2 > 0 and t1 > t2)

// The address of an IA Address option at `o`.
pub @tier(embedded)
@no_alloc
fn iaaddr_address(var m: Vec[u8; 1024], o: Int) -> dhcp6msg.Ip6
    dhcp6msg.ip6_at(var m, o + 4)

// The preferred lifetime of an IA Address option, in seconds.
pub @tier(embedded)
@no_alloc
fn iaaddr_preferred(var m: Vec[u8; 1024], o: Int) -> Int
    dhcp6msg.u32_at(var m, o + 20)

// The valid lifetime of an IA Address option, in seconds.
pub @tier(embedded)
@no_alloc
fn iaaddr_valid(var m: Vec[u8; 1024], o: Int) -> Int
    dhcp6msg.u32_at(var m, o + 24)

// Where the options inside an IA Address option start.
pub @tier(embedded)
@no_alloc
fn iaaddr_options_start(o: Int) -> Int
    o + 28

// Whether an IA Address option is long enough and has a preferred
// lifetime no greater than the valid one (section 21.6).
pub @tier(embedded)
@no_alloc
fn iaaddr_is_usable(var m: Vec[u8; 1024], o: Int) -> Bool
    o >= 0 and dhcp6msg.opt_len(var m, o) >= 24 and dhcp6msg.opt_end(var m, o) <= m.len()
        and iaaddr_preferred(var m, o) <= iaaddr_valid(var m, o)

// The preferred lifetime of an IA Prefix option, in seconds.
pub @tier(embedded)
@no_alloc
fn iaprefix_preferred(var m: Vec[u8; 1024], o: Int) -> Int
    dhcp6msg.u32_at(var m, o + 4)

// The valid lifetime of an IA Prefix option, in seconds.
pub @tier(embedded)
@no_alloc
fn iaprefix_valid(var m: Vec[u8; 1024], o: Int) -> Int
    dhcp6msg.u32_at(var m, o + 8)

// The prefix length of an IA Prefix option, in bits.
pub @tier(embedded)
@no_alloc
fn iaprefix_length(var m: Vec[u8; 1024], o: Int) -> Int
    dhcp6msg.u8_at(var m, o + 12)

// The prefix of an IA Prefix option, all 128 bits as the sender wrote
// them.
pub @tier(embedded)
@no_alloc
fn iaprefix_prefix(var m: Vec[u8; 1024], o: Int) -> dhcp6msg.Ip6
    dhcp6msg.ip6_at(var m, o + 13)

// Where the options inside an IA Prefix option start.
pub @tier(embedded)
@no_alloc
fn iaprefix_options_start(o: Int) -> Int
    o + 29

// Whether an IA Prefix option is long enough, has a preferred lifetime
// no greater than the valid one and a length of at most 128 bits
// (section 21.22).
pub @tier(embedded)
@no_alloc
fn iaprefix_is_usable(var m: Vec[u8; 1024], o: Int) -> Bool
    o >= 0 and dhcp6msg.opt_len(var m, o) >= 25 and dhcp6msg.opt_end(var m, o) <= m.len()
        and iaprefix_preferred(var m, o) <= iaprefix_valid(var m, o) and iaprefix_length(var m, o) <= 128

// T1 for an IA in which the server sent `server_t1` and the shortest
// preferred lifetime is `shortest_preferred`, all in seconds.  A T1 of
// zero is left to the client (section 14.2), which takes the 0.5 of the
// shortest preferred lifetime that section 21.4 recommends.  Infinity
// stays infinity.
pub @tier(embedded)
@no_alloc
fn choose_t1(server_t1: Int, shortest_preferred: Int) -> Int
    if server_t1 > 0
        server_t1
    elif shortest_preferred == dhcp6msg.DHCP6_INFINITY
        dhcp6msg.DHCP6_INFINITY
    else
        shortest_preferred / 2

// T2 for an IA, as `choose_t1`, with the 0.8 that section 21.4
// recommends.
pub @tier(embedded)
@no_alloc
fn choose_t2(server_t2: Int, shortest_preferred: Int) -> Int
    if server_t2 > 0
        server_t2
    elif shortest_preferred == dhcp6msg.DHCP6_INFINITY
        dhcp6msg.DHCP6_INFINITY
    else
        shortest_preferred * 8 / 10

// ── Status Code ─────────────────────────────────────────────────────

// The status in the Status Code option found between `lo` and `hi`: the
// code, 0 when the area holds no such option (section 21.13 says
// Success is then assumed), or -1 when the option is shorter than its
// two-byte code.
pub @tier(embedded)
@no_alloc
fn status_code(var m: Vec[u8; 1024], lo: Int, hi: Int) -> Int
    let o = dhcp6msg.find_option(var m, lo, hi, dhcp6msg.DHCP6_OPT_STATUS_CODE, 0)
    if o < 0
        0
    elif dhcp6msg.opt_len(var m, o) < 2
        -1
    else
        dhcp6msg.u16_at(var m, o + 4)

// The status of a message: the Status Code among its own options.
pub @tier(embedded)
@no_alloc
fn message_status(var m: Vec[u8; 1024]) -> Int
    status_code(var m, dhcp6msg.options_start(var m), dhcp6msg.options_end(var m))

// The length of the status message of the Status Code option at `o`.
pub @tier(embedded)
@no_alloc
fn status_message_len(var m: Vec[u8; 1024], o: Int) -> Int
    let n = dhcp6msg.opt_len(var m, o) - 2
    if n < 0
        0
    else
        n

// Byte `i` of the status message of the Status Code option at `o`, or
// -1.
pub @tier(embedded)
@no_alloc
fn status_message_byte(var m: Vec[u8; 1024], o: Int, i: Int) -> Int
    if i < 0 or i >= status_message_len(var m, o)
        -1
    else
        dhcp6msg.u8_at(var m, o + 6 + i)

// ── Small options ───────────────────────────────────────────────────

// The Preference of a server, or 0 when the message has none (section
// 18.2.1: an Advertise without one is taken as 0).
pub @tier(embedded)
@no_alloc
fn preference(var m: Vec[u8; 1024]) -> Int
    let o = dhcp6msg.find(var m, dhcp6msg.DHCP6_OPT_PREFERENCE)
    if o >= 0 and dhcp6msg.opt_len(var m, o) == 1
        dhcp6msg.u8_at(var m, o + 4)
    else
        0

// The Elapsed Time of a message in hundredths of a second, or -1.
pub @tier(embedded)
@no_alloc
fn elapsed_time(var m: Vec[u8; 1024]) -> Int
    let o = dhcp6msg.find(var m, dhcp6msg.DHCP6_OPT_ELAPSED_TIME)
    if o >= 0 and dhcp6msg.opt_len(var m, o) == 2
        dhcp6msg.u16_at(var m, o + 4)
    else
        -1

// Whether a message carries the Rapid Commit option.
pub @tier(embedded)
@no_alloc
fn has_rapid_commit(var m: Vec[u8; 1024]) -> Bool
    dhcp6msg.find(var m, dhcp6msg.DHCP6_OPT_RAPID_COMMIT) >= 0

// Whether a message carries the Reconfigure Accept option.
pub @tier(embedded)
@no_alloc
fn has_reconfigure_accept(var m: Vec[u8; 1024]) -> Bool
    dhcp6msg.find(var m, dhcp6msg.DHCP6_OPT_RECONF_ACCEPT) >= 0

// The message type a Reconfigure message asks for, `DHCP6_RENEW` or
// `DHCP6_INFORMATION_REQUEST`, or -1 when the option is absent or has
// another length than one byte.
pub @tier(embedded)
@no_alloc
fn reconfigure_kind(var m: Vec[u8; 1024]) -> Int
    let o = dhcp6msg.find(var m, dhcp6msg.DHCP6_OPT_RECONF_MSG)
    if o >= 0 and dhcp6msg.opt_len(var m, o) == 1
        dhcp6msg.u8_at(var m, o + 4)
    else
        -1

// The address in the Server Unicast option, or :: when there is none.
pub @tier(embedded)
@no_alloc
fn server_unicast(var m: Vec[u8; 1024]) -> dhcp6msg.Ip6
    let o = dhcp6msg.find(var m, dhcp6msg.DHCP6_OPT_UNICAST)
    if o >= 0 and dhcp6msg.opt_len(var m, o) == 16
        dhcp6msg.ip6_at(var m, o + 4)
    else
        dhcp6msg.ip6_zero()

// Whether a message carries a well-formed Server Unicast option.
pub @tier(embedded)
@no_alloc
fn has_server_unicast(var m: Vec[u8; 1024]) -> Bool
    let o = dhcp6msg.find(var m, dhcp6msg.DHCP6_OPT_UNICAST)
    o >= 0 and dhcp6msg.opt_len(var m, o) == 16 and dhcp6msg.opt_end(var m, o) <= m.len()

// A 32-bit option of a message (Information Refresh Time, SOL_MAX_RT,
// INF_MAX_RT) or -1 when it is absent or not four bytes.
pub @tier(embedded)
@no_alloc
fn option_u32(var m: Vec[u8; 1024], code: Int) -> Int
    let o = dhcp6msg.find(var m, code)
    if o >= 0 and dhcp6msg.opt_len(var m, o) == 4
        dhcp6msg.u32_at(var m, o + 4)
    else
        -1

// The Information Refresh Time in seconds, with the rules of section
// 21.23: the default when the option is absent, and never below
// `DHCP6_IRT_MINIMUM`.  Infinity is kept.
pub @tier(embedded)
@no_alloc
fn info_refresh_time(var m: Vec[u8; 1024]) -> Int
    let v = option_u32(var m, dhcp6msg.DHCP6_OPT_INFO_REFRESH_TIME)
    if v < 0
        DHCP6_IRT_DEFAULT
    elif v < DHCP6_IRT_MINIMUM
        DHCP6_IRT_MINIMUM
    else
        v

// The SOL_MAX_RT of a message in seconds, or -1 when the option is
// absent or outside 60 to 86400, the range section 21.24 allows.
pub @tier(embedded)
@no_alloc
fn sol_max_rt(var m: Vec[u8; 1024]) -> Int
    let v = option_u32(var m, dhcp6msg.DHCP6_OPT_SOL_MAX_RT)
    if v < DHCP6_MAX_RT_MIN or v > DHCP6_MAX_RT_MAX
        -1
    else
        v

// The INF_MAX_RT of a message in seconds, or -1, with the range of
// section 21.25.
pub @tier(embedded)
@no_alloc
fn inf_max_rt(var m: Vec[u8; 1024]) -> Int
    let v = option_u32(var m, dhcp6msg.DHCP6_OPT_INF_MAX_RT)
    if v < DHCP6_MAX_RT_MIN or v > DHCP6_MAX_RT_MAX
        -1
    else
        v

// How many option codes the Option Request option of a message lists.
pub @tier(embedded)
@no_alloc
fn oro_count(var m: Vec[u8; 1024]) -> Int
    let o = dhcp6msg.find(var m, dhcp6msg.DHCP6_OPT_ORO)
    if o < 0
        0
    else
        dhcp6msg.opt_len(var m, o) / 2

// The `i`-th code of the Option Request option, or -1.
pub @tier(embedded)
@no_alloc
fn oro_code(var m: Vec[u8; 1024], i: Int) -> Int
    let o = dhcp6msg.find(var m, dhcp6msg.DHCP6_OPT_ORO)
    if o < 0 or i < 0 or i >= oro_count(var m)
        -1
    else
        dhcp6msg.u16_at(var m, o + 4 + 2 * i)

// Whether the Option Request option of a message lists `code`.
pub @tier(embedded)
@no_alloc
fn oro_contains(var m: Vec[u8; 1024], code: Int) -> Bool
    var yes = false
    for i in 0..oro_count(var m)
        if oro_code(var m, i) == code
            yes = true
    yes

// ── DNS servers and the search list (RFC 3646) ──────────────────────

// How many addresses the DNS Recursive Name Server option holds, or 0
// when it is absent or its length is not a multiple of sixteen.
pub @tier(embedded)
@no_alloc
fn dns_server_count(var m: Vec[u8; 1024]) -> Int
    let o = dhcp6msg.find(var m, dhcp6msg.DHCP6_OPT_DNS_SERVERS)
    if o < 0 or dhcp6msg.opt_len(var m, o) % 16 != 0
        0
    else
        dhcp6msg.opt_len(var m, o) / 16

// The `i`-th DNS server address, or ::.
pub @tier(embedded)
@no_alloc
fn dns_server(var m: Vec[u8; 1024], i: Int) -> dhcp6msg.Ip6
    let o = dhcp6msg.find(var m, dhcp6msg.DHCP6_OPT_DNS_SERVERS)
    if i < 0 or i >= dns_server_count(var m)
        dhcp6msg.ip6_zero()
    else
        dhcp6msg.ip6_at(var m, o + 4 + 16 * i)

// Write the DNS Recursive Name Server option from up to eight addresses
// held in `servers`.
pub @tier(embedded)
@no_alloc
fn put_dns_servers(var m: Vec[u8; 1024], var servers: Vec[dhcp6msg.Ip6; 8]) -> Bool
    var ok = dhcp6msg.put_u16(var m, dhcp6msg.DHCP6_OPT_DNS_SERVERS) and dhcp6msg.put_u16(var m, servers.len() * 16)
    for i in 0..servers.len()
        ok = ok and dhcp6msg.put_ip6(var m, servers[i])
    ok

// The offset after the domain name that starts at `at`, in the label
// form of RFC 1035 section 3.1 with no compression, read inside the
// area that ends at `hi`; or -1 when a label is longer than 63 bytes, is
// a compression pointer, or runs past `hi`.
pub @tier(embedded)
@no_alloc
fn domain_next(var m: Vec[u8; 1024], at: Int, hi: Int) -> Int
    var pos = at
    var result = -1
    var live = at >= 0
    for _ in 0..130
        if live
            if pos >= hi or pos >= m.len()
                live = false
            else
                let len = dhcp6msg.u8_at(var m, pos)
                if len == 0
                    result = pos + 1
                    live = false
                elif len > 63 or pos + 1 + len >= hi
                    live = false
                else
                    pos = pos + 1 + len
    result

// The offset of the `n`-th domain name in the data of the option at `o`
// (the Domain Search List, or any option that is a run of names), or -1.
pub @tier(embedded)
@no_alloc
fn domain_nth(var m: Vec[u8; 1024], o: Int, n: Int) -> Int
    var pos = dhcp6msg.opt_data(o)
    let hi = dhcp6msg.opt_end(var m, o)
    var result = -1
    var k = 0
    var live = o >= 0 and n >= 0
    for _ in 0..130
        if live and pos < hi
            let nxt = domain_next(var m, pos, hi)
            if nxt < 0
                live = false
            elif k == n
                result = pos
                live = false
            else
                k = k + 1
                pos = nxt
        else
            live = false
    result

// How many well-formed names the option at `o` holds, counted up to the
// first that is not.
pub @tier(embedded)
@no_alloc
fn domain_count(var m: Vec[u8; 1024], o: Int) -> Int
    var n = 0
    for i in 0..130
        if domain_nth(var m, o, i) >= 0
            n = n + 1
    n

// The domain name at `at` as text with the labels joined by dots and no
// trailing dot, written into `out` (replacing its content); the root is
// written as one dot.  Answers false when the name is malformed or the
// text would not fit in 255 bytes.
pub @tier(embedded)
@no_alloc
fn domain_text(var m: Vec[u8; 1024], at: Int, hi: Int, var out: Vec[u8; 256]) -> Bool
    out.clear()
    let end = domain_next(var m, at, hi)
    if end < 0
        false
    else
        var pos = at
        var ok = true
        var first = true
        for _ in 0..130
            if pos < end - 1
                let len = dhcp6msg.u8_at(var m, pos)
                if not first
                    ok = ok and push_char(var out, 46)
                first = false
                for j in 0..len
                    ok = ok and push_char(var out, dhcp6msg.u8_at(var m, pos + 1 + j))
                pos = pos + 1 + len
        if first
            ok = push_char(var out, 46)
        ok

// Append one byte to a text buffer.
@tier(embedded)
@no_alloc
fn push_char(var out: Vec[u8; 256], v: Int) -> Bool
    match out.push((v & 255) as u8)
        Ok(_)  => true
        Err(_) => false

// Append the name written in `text` as dotted ASCII, such as
// `example.com` with or without a closing dot, to the message in the
// label form of RFC 1035.  Answers false, and leaves a partial name,
// when a label is empty or longer than 63 bytes or the buffer is full.
// `.` alone is the root.  A name of up to 128 bytes of text is at most
// 130 bytes in label form, inside the 255 RFC 1035 allows.
pub @tier(embedded)
@no_alloc
fn put_domain_name(var m: Vec[u8; 1024], var text: Vec[u8; 128]) -> Bool
    let n = text.len()
    if n == 0
        return false
    if n == 1 and text[0] == 46
        return dhcp6msg.put_u8(var m, 0)
    var ok = dhcp6msg.put_u8(var m, 0)
    var label_at = m.len() - 1
    var label_len = 0
    for i in 0..n
        let c = text[i] as Int
        if ok
            if c == 46
                if label_len == 0
                    ok = false
                else
                    m[label_at] = label_len as u8
                    label_at = m.len()
                    label_len = 0
                    ok = dhcp6msg.put_u8(var m, 0)
            elif label_len >= 63
                ok = false
            else
                ok = dhcp6msg.put_u8(var m, c)
                label_len = label_len + 1
    if ok and label_len > 0
        m[label_at] = label_len as u8
        ok = dhcp6msg.put_u8(var m, 0)
    ok

// ── NTP servers (RFC 5908) ──────────────────────────────────────────

// The offset of the `nth` sub-option with `code` inside the NTP Server
// option at `o`, or -1.  Its data is read with the offsets of
// `dhcp6msg`; `ntp_address` reads an address one.
pub @tier(embedded)
@no_alloc
fn ntp_suboption(var m: Vec[u8; 1024], o: Int, code: Int, nth: Int) -> Int
    if o < 0
        -1
    else
        dhcp6msg.find_option(var m, dhcp6msg.opt_data(o), dhcp6msg.opt_end(var m, o), code, nth)

// The address in an NTP server or multicast sub-option at `sub`, or ::
// when the sub-option is not sixteen bytes.
pub @tier(embedded)
@no_alloc
fn ntp_address(var m: Vec[u8; 1024], sub: Int) -> dhcp6msg.Ip6
    if sub >= 0 and dhcp6msg.opt_len(var m, sub) == 16
        dhcp6msg.ip6_at(var m, sub + 4)
    else
        dhcp6msg.ip6_zero()

// Start an NTP Server option; write sub-options, then `close_option`.
pub @tier(embedded)
@no_alloc
fn open_ntp_server(var m: Vec[u8; 1024]) -> Int
    dhcp6msg.open_option(var m, dhcp6msg.DHCP6_OPT_NTP_SERVER)

// A sub-option holding a server address, inside an NTP Server option.
pub @tier(embedded)
@no_alloc
fn put_ntp_server_address(var m: Vec[u8; 1024], x: dhcp6msg.Ip6) -> Bool
    dhcp6msg.put_option_ip6(var m, DHCP6_NTP_SRV_ADDR, x)

// A sub-option holding a multicast address, inside an NTP Server option.
pub @tier(embedded)
@no_alloc
fn put_ntp_multicast_address(var m: Vec[u8; 1024], x: dhcp6msg.Ip6) -> Bool
    dhcp6msg.put_option_ip6(var m, DHCP6_NTP_MC_ADDR, x)

// ── Classes and vendor options ──────────────────────────────────────

// The offset of the length of the `n`-th class-data item in the User
// Class option at `o`, or -1.  An item is a 16-bit length and that many
// bytes (section 21.15); its data starts at the offset plus 2.
pub @tier(embedded)
@no_alloc
fn user_class_item(var m: Vec[u8; 1024], o: Int, n: Int) -> Int
    class_item(var m, dhcp6msg.opt_data(o), dhcp6msg.opt_end(var m, o), n)

// The enterprise number of a Vendor Class option or a Vendor-specific
// Information option at `o` (sections 21.16 and 21.17).
pub @tier(embedded)
@no_alloc
fn vendor_enterprise(var m: Vec[u8; 1024], o: Int) -> Int
    dhcp6msg.u32_at(var m, o + 4)

// The offset of the length of the `n`-th class-data item in the Vendor
// Class option at `o`, or -1.
pub @tier(embedded)
@no_alloc
fn vendor_class_item(var m: Vec[u8; 1024], o: Int, n: Int) -> Int
    class_item(var m, o + 8, dhcp6msg.opt_end(var m, o), n)

// The length of the class-data item whose length is at `item`.
pub @tier(embedded)
@no_alloc
fn class_item_len(var m: Vec[u8; 1024], item: Int) -> Int
    dhcp6msg.u16_at(var m, item)

// Where the items of a run that starts at `lo` and ends at `hi`, each a
// 16-bit length and its bytes, put the `n`-th, or -1.
@tier(embedded)
@no_alloc
fn class_item(var m: Vec[u8; 1024], lo: Int, hi: Int, n: Int) -> Int
    var pos = lo
    var k = 0
    var result = -1
    var live = lo >= 0 and n >= 0
    for _ in 0..512
        if live and pos + 2 <= hi
            let len = dhcp6msg.u16_at(var m, pos)
            if pos + 2 + len > hi
                live = false
            elif k == n
                result = pos
                live = false
            else
                k = k + 1
                pos = pos + 2 + len
        else
            live = false
    result

// The offset of the `nth` option with `code` among the sub-options of a
// Vendor-specific Information option at `o`, or -1.  The sub-options are
// the vendor's: a code, a length and data, as options are.
pub @tier(embedded)
@no_alloc
fn vendor_suboption(var m: Vec[u8; 1024], o: Int, code: Int, nth: Int) -> Int
    if o < 0
        -1
    else
        dhcp6msg.find_option(var m, o + 8, dhcp6msg.opt_end(var m, o), code, nth)

// ── Authentication (read only) ──────────────────────────────────────

// The protocol field of the Authentication option at `o`.
pub @tier(embedded)
@no_alloc
fn auth_protocol(var m: Vec[u8; 1024], o: Int) -> Int
    dhcp6msg.u8_at(var m, o + 4)

// The algorithm field of the Authentication option at `o`.
pub @tier(embedded)
@no_alloc
fn auth_algorithm(var m: Vec[u8; 1024], o: Int) -> Int
    dhcp6msg.u8_at(var m, o + 5)

// The replay detection method field of the Authentication option at `o`.
pub @tier(embedded)
@no_alloc
fn auth_rdm(var m: Vec[u8; 1024], o: Int) -> Int
    dhcp6msg.u8_at(var m, o + 6)

// The high 32 bits of the 64-bit replay detection field.
pub @tier(embedded)
@no_alloc
fn auth_replay_high(var m: Vec[u8; 1024], o: Int) -> Int
    dhcp6msg.u32_at(var m, o + 7)

// The low 32 bits of the 64-bit replay detection field.
pub @tier(embedded)
@no_alloc
fn auth_replay_low(var m: Vec[u8; 1024], o: Int) -> Int
    dhcp6msg.u32_at(var m, o + 11)

// The length of the authentication information, which follows the
// 11-byte fixed part.
pub @tier(embedded)
@no_alloc
fn auth_info_len(var m: Vec[u8; 1024], o: Int) -> Int
    let n = dhcp6msg.opt_len(var m, o) - 11
    if n < 0
        0
    else
        n

// Where the authentication information starts.
pub @tier(embedded)
@no_alloc
fn auth_info_start(o: Int) -> Int
    o + 15
